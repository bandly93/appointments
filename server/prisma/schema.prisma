generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STAFF
  PROVIDER
  ADMIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DocumentRequestStatus {
  UNVERIFIED
  PENDING
  FULFILLED
  DECLINED
  CANCELLED
  EXPIRED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  displayName  String?

  sessions          Session[]
  availabilityRules AvailabilityRule[]
  bookingRequests   BookingRequest[]
  appointments      Appointment[]
  uploadedDocuments PatientDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AvailabilityRule {
  id         String @id @default(cuid())
  providerId String
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  dayOfWeek           DayOfWeek
  startMinute         Int
  endMinute           Int
  slotDurationMinutes Int       @default(30)
  timezone            String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

model Patient {
  id    String  @id @default(cuid())
  email String  @unique
  name  String
  phone String?

  // Stored as YYYY-MM-DD to avoid timezone shifts on a date-only value.
  dateOfBirth String?
  address     String?

  bookingRequests  BookingRequest[]
  appointments     Appointment[]
  documentRequests DocumentRequest[]
  documents        PatientDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A standalone file attached directly to a patient's record — e.g. a
// photographed ID or insurance card — independent of the request/fulfill
// lifecycle in DocumentRequest. Staff/provider can upload at any time;
// patients can upload their own via their booking access-token link.
model PatientDocument {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  documentType String

  // Who added it. uploadedByUserId is null when the patient uploaded it
  // themselves; uploadedByRole records the actor's role at upload time
  // ("STAFF" | "PROVIDER" | "PATIENT") for display without joining User
  // for the patient-uploaded case.
  uploadedByUserId String?
  uploadedByUser   User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByRole   String

  // Hides the document from the patient's own view when a staff/provider
  // upload isn't meant to be patient-facing. Always true for patient
  // self-uploads (hiding a patient's own upload from themselves makes no
  // sense).
  visibleToPatient Boolean @default(true)

  fileOriginalName String
  fileStorageKey   String @unique
  fileMimeType     String
  fileSizeBytes    Int

  createdAt DateTime @default(now())

  @@index([patientId])
}

model DocumentRequest {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  documentType String
  message      String?
  status       DocumentRequestStatus @default(UNVERIFIED)

  accessTokenHash String @unique

  // Same email-confirmation pattern as BookingRequest.
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int       @default(0)

  // The attached file, if staff fulfilled the request with an upload.
  // fileStorageKey is a server-generated name on disk, never derived from
  // client input, so it doubles as protection against path traversal.
  fileOriginalName String?
  fileStorageKey   String?   @unique
  fileMimeType     String?
  fileSizeBytes    Int?
  fileUploadedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model BookingRequest {
  id         String  @id @default(cuid())
  providerId String
  provider   User    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  status   BookingStatus @default(UNVERIFIED)
  notes    String?

  accessTokenHash String @unique

  // Email confirmation: possessing the emailed link (i.e. the raw token) is
  // itself the proof — there's no separate code. The slot is a soft-hold
  // while UNVERIFIED and expires if the patient doesn't confirm in time (see
  // the partial unique index in the migration, which also treats UNVERIFIED
  // as slot-blocking).
  verificationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment?

  @@index([providerId, startsAt])
  @@index([patientId])
}

model Appointment {
  id         String  @id @default(cuid())
  providerId String
  provider   User    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  bookingRequestId String?         @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)

  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(SCHEDULED)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, startsAt])
  @@index([patientId])
}
